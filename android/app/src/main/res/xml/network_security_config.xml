<?xml version="1.0" encoding="utf-8"?>
<!-- A Muzix server at home is often plain http on the local network (http://192.168.1.10:8484) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
